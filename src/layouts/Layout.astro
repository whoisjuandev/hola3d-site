---
import '../styles/styles.css';
import fontUrl from '../assets/AlloVariable.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {BUSINESS, PLACE, returnPolicy} from '../data/site.js';

const {title, description, home = false, image = '/assets/og.jpg', themeColor = '#8DD3F7', schema = []} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#negocio', Astro.site).href,
  name: BUSINESS.name,
  slogan: BUSINESS.tagline,
  description: `Impresión 3D a pedido en ${PLACE}. ${BUSINESS.shipping}. Los pedidos se hacen por WhatsApp.`,
  url: Astro.site.href,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  legalName: BUSINESS.legalName,
  taxID: BUSINESS.taxId,
  hasMerchantReturnPolicy: returnPolicy(Astro.site),
  logo: new URL('/assets/cubo.svg', Astro.site).href,
  image: imageUrl.href,
  address: {'@type': 'PostalAddress', addressLocality: BUSINESS.city, addressRegion: BUSINESS.province, addressCountry: BUSINESS.country},
  areaServed: {'@type': 'Country', name: 'Argentina'},
};
---
<!doctype html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content={themeColor}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={BUSINESS.name}>
<meta property="og:locale" content="es_AR">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={imageUrl}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/cubo.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin>
<!-- Handwritten notes. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gochi+Hand&display=swap">
{[business, ...schema].map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
<slot name="head" />
</head>
<body>
<a class="skip" href={home ? '#productos' : '#contenido'}>{home ? 'Ir a los productos' : 'Ir al contenido'}</a>
<slot name="stage" />
<Nav home={home} />
<slot />
<Footer />
<slot name="after" />
<p class="visually-hidden" role="status" aria-live="polite" data-live></p>
</body>
</html>
